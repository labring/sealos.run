# [FIXME] Remove LEGACY env vars
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OPEN_SOURCE_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Rybbit Analytics (self-hosted). Leave empty to disable.
NEXT_PUBLIC_RYBBIT_HOST=
NEXT_PUBLIC_RYBBIT_SITE_ID=
# Showcase (/showcase). All runtime only; never build args.
# PostgreSQL for listed projects and votes. Empty: the showcase shows no projects.
SHOWCASE_DATABASE_URL=
# Bearer secret for POST /api/showcase/sync; also salts the hashed voter IPs.
SHOWCASE_SYNC_SECRET=
# Feishu self-built app with read access to the submissions Base.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# The Base token (app_token) and table id of the submissions table.
SHOWCASE_FEISHU_BASE_TOKEN=
SHOWCASE_FEISHU_TABLE_ID=
# S3-compatible bucket (public read) for cover images.
SHOWCASE_S3_ENDPOINT=
SHOWCASE_S3_BUCKET=
SHOWCASE_S3_ACCESS_KEY=
SHOWCASE_S3_SECRET_KEY=
# Optional: public address of the bucket. Defaults to <endpoint>/<bucket>.
SHOWCASE_S3_PUBLIC_BASE_URL=
# Optional: Feishu group (chat_id, oc_...) for sync alerts. The app's bot must be in the group.
SHOWCASE_ALERT_CHAT_ID=
