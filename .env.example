# [FIXME] Remove LEGACY env vars
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OPEN_SOURCE_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Rybbit Analytics (self-hosted). Leave empty to disable.
NEXT_PUBLIC_RYBBIT_HOST=
NEXT_PUBLIC_RYBBIT_SITE_ID=
# Showcase (/showcase). All runtime only; never build args.
# PostgreSQL for sync and live votes. Published projects are read from the public S3 catalog.
SHOWCASE_DATABASE_URL=
# Registered Sealos authorization-code client. Use HTTPS outside local testing.
SHOWCASE_AUTH_ORIGIN=
SHOWCASE_AUTH_CLIENT_ID=
SHOWCASE_AUTH_CALLBACK_URL=
# At least 32 random bytes; signs the website's short-lived login/session cookies.
SHOWCASE_AUTH_SECRET=
# Set to 1 to turn voting off (UI shows it as unavailable; the vote API returns 503) even when auth is configured.
SHOWCASE_VOTING_DISABLED=
# Enables scheduled and manual sync. Set to 1 only in the test deployment; leave unset in production.
SHOWCASE_SYNC_ENABLED=
# Optional bearer secret for manually calling POST /api/showcase/sync; the scheduler does not use it.
SHOWCASE_SYNC_SECRET=
# Feishu self-built app: read the submissions Base and public attachments; send sync alerts if configured.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# The Base token (app_token) and table id of the submissions table.
SHOWCASE_FEISHU_BASE_TOKEN=
SHOWCASE_FEISHU_TABLE_ID=
# S3-compatible bucket (public read) for curated images and showcase/catalog.json.
SHOWCASE_S3_ENDPOINT=
SHOWCASE_S3_BUCKET=
SHOWCASE_S3_ACCESS_KEY=
SHOWCASE_S3_SECRET_KEY=
# Public HTTP(S) address of the bucket, used to read the catalog and cover images.
SHOWCASE_S3_PUBLIC_BASE_URL=
# Optional: Feishu group (chat_id, oc_...) for sync alerts. The app's bot must be in the group.
SHOWCASE_ALERT_CHAT_ID=
